  "item": [
    {
      "name": "Create a Product-DataDriven",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var responseData = pm.response.json();\r",
              "\r",
              "pm.test(\"Status code is 201\", () => {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"Title matches\",()=>{\r",
              "pm.expect(responseData.title).to.eql(pm.iterationData.get(\"title\"));\r",
              "})\r",
              "\r",
              "pm.test(\"Price matches\",()=>{\r",
              "pm.expect(responseData.price).to.eql(pm.iterationData.get(\"price\"));\r",
              "})\r",
              "\r",
              "pm.test(\"Description matches\",()=>{\r",
              "pm.expect(responseData.description).to.eql(pm.iterationData.get(\"description\"));\r",
              "})\r",
              "\r",
              "pm.test(\"Category matches\",()=>{\r",
              "pm.expect(responseData.category).to.eql(pm.iterationData.get(\"category\"));\r",
              "})"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n   \"title\": \"{{title}}\",\r\n   \"price\": \"{{price}}\",\r\n   \"description\": \"{{description}}\",\r\n   \"category\": \"{{category}}\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{BASE_URL}}/products",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "products"
          ]
        }
      },
      "response": []
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
