              "    pm.expect(jsonData.title).to.be.a(\"string\");\r",
              "    pm.expect(jsonData.price).to.be.a(\"number\");\r",
              "    pm.expect(jsonData.description).to.be.a(\"string\");\r",
              "    pm.expect(jsonData.category).to.be.a(\"string\");\r",
              "    pm.expect(jsonData.image).to.be.a(\"string\");\r",
              "    pm.expect(jsonData.rating).to.be.an(\"object\");\r",
              "    pm.expect(jsonData.rating.rate).to.be.a(\"number\");\r",
              "    pm.expect(jsonData.rating.count).to.be.a(\"number\");\r",
              "})\r",
              "\r",
              "pm.test(\"Validate Image is a URL\", () => {\r",
              "    pm.expect(jsonData.image).to.match(/^https?:\\/\\//);\r",
              "})\r",
              "\r",
              "pm.test(\"Validate price is not negative\", () => {\r",
              "    pm.expect(jsonData.price).to.be.greaterThan(0);\r",
              "})\r",
              "\r",
              "\r",
              "pm.test(\"Validate price is within a range\", () => {\r",
              "    pm.expect(jsonData.price).to.be.within(0, 10000);\r",
              "})\r",
              "\r",
              "pm.test(\"Validate category has only specific list\", () => {\r",
              "    const validCategories = [\"men's clothing\", \"women's clothing\", \"jewelery\", \"electronics\", \"home & garden\"];\r",
              "    pm.expect(validCategories).to.include(jsonData.category);\r",
              "\r",
              "})\r",
              "\r",
              "\r",
              "\r",
