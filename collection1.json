  "item": [
    {
      "name": "Get Products",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"Status code is 200\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response time is less than 1000ms\", () => {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
              "});\r",
              "\r",
              "pm.test(\"Response to be json\", () => {\r",
              "    pm.expect(pm.response.to.be.json);\r",
              "});\r",
              "\r",
              "pm.test(\"Response to be an array\", () => {\r",
              "    console.log(jsonData);\r",
              "    pm.expect(jsonData).to.be.an('array');\r",
              "});\r",
              "\r",
              "pm.test(\"Response count to be 20\", () => {\r",
              "    pm.expect(jsonData.length).to.equal(20);\r",
              "});\r",
              "\r",
              "pm.test(\"Response has the properties\", () => {\r",
              "    pm.expect(jsonData[0]).to.have.property('id');\r",
              "    pm.expect(jsonData[0]).to.have.property('title');\r",
              "    pm.expect(jsonData[0]).to.have.property('price');\r",
              "    pm.expect(jsonData[0]).to.have.property('description');\r",
              "    pm.expect(jsonData[0]).to.have.property('category');\r",
              "    pm.expect(jsonData[0]).to.have.property('image');\r",
              "    pm.expect(jsonData[0]).to.have.property('rating');\r",
              "    pm.expect(jsonData[0].rating).to.have.property('rate');\r",
              "    pm.expect(jsonData[0].rating).to.have.property('count');\r",
              "});\r",
              "\r",
              "pm.test(\"Validate Data type\", () => {\r",
              "    jsonData.forEach(function (product) {\r",
              "        pm.expect(product.id).to.be.a(\"number\");\r",
              "        pm.expect(product.title).to.be.a(\"string\");\r",
              "        pm.expect(product.price).to.be.a(\"number\");\r",
              "        pm.expect(product.description).to.be.a(\"string\");\r",
              "        pm.expect(product.category).to.be.a(\"string\");\r",
              "        pm.expect(product.image).to.be.a(\"string\");\r",
              "        pm.expect(product.rating).to.be.an(\"object\");\r",
              "        pm.expect(product.rating.rate).to.be.a(\"number\");\r",
              "        pm.expect(product.rating.count).to.be.a(\"number\");\r",
              "    })\r",
              "})\r",
              "\r",
              "pm.test(\"Validate Image is a URL\", () => {\r",
              "    jsonData.forEach(function (product) {\r",
              "        pm.expect(product.image).to.match(/^https?:\\/\\//);\r",
              "    })\r",
              "})\r",
              "\r",
              "pm.test(\"Validate price is not negative\", () => {\r",
              "    jsonData.forEach(function (product) {\r",
              "        pm.expect(product.price).to.be.greaterThan(0);\r",
              "    })\r",
              "})\r",
              "\r",
              "pm.test(\"Validate price is within a range\", () => {\r",
              "    jsonData.forEach(function (product) {\r",
              "        pm.expect(product.price).to.be.within(0,10000);\r",
              "    })\r",
              "})\r",
              "\r",
              "pm.test(\"Validate category has only specific list\",()=>{\r",
              "    const validCategories = [\"men's clothing\", \"women's clothing\", \"jewelery\", \"electronics\", \"home & garden\"];\r",
              "\r",
              "    jsonData.forEach(function(product){\r",
              "        pm.expect(validCategories).to.include(product.category);\r",
              "    })\r",
              "\r",
              "})\r",
              "\r",
              "\r",
              "\r",
              "\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
