    {
      "name": "Create a Product",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "let randomId = Math.floor(Math.random() * 100000);\r",
              "let product = \"Test Product \" + randomId;\r",
              "console.log(product)\r",
              "let productPrice = Math.floor(Math.random() * 1000) + 100;\r",
              "console.log(productPrice)\r",
              "\r",
              "pm.environment.set(\"product\", product)\r",
              "pm.environment.set(\"productPrice\", productPrice)"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log(pm.environment.get(\"product\"))\r",
              "console.log(pm.environment.get(\"productPrice\"))\r",
              "\r",
              "pm.test(\"Validate status code is 201\", () => {\r",
              "    pm.response.to.have.status(201);\r",
              "})\r",
              "\r",
              "pm.test(\"Validate response body is not empty\", () => {\r",
              "    pm.expect(pm.response.json()).to.not.be.empty;\r",
              "})\r",
              "\r",
              "let requestData = pm.request.body.raw;\r",
              "let requestJson = JSON.parse(requestData);\r",
              "let responseJson = pm.response.json();\r",
              "\r",
              "pm.test(\"Validate request json is equal to response json\", () => {\r",
              "    pm.expect(responseJson.title).to.eql(requestJson.title);\r",
              "    pm.expect(responseJson.price).to.eql(requestJson.price);\r",
              "    pm.expect(responseJson.description).to.eql(requestJson.description);\r",
              "    pm.expect(responseJson.category).to.eql(requestJson.category);\r",
              "})\r",
              "\r",
              "pm.environment.set(\"resProductId\", responseJson.id)\r",
              "console.log(pm.environment.get(\"resProductId\"))\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
